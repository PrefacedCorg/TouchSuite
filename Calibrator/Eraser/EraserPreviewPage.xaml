<UserControl x:Class="TouchErase.Calibrator.Eraser.EraserPreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左：预览区 -->
        <Grid Grid.Column="0">
            <Border x:Name="Host" Background="#FF101010"
                    TouchDown="OnHostTouchDown" TouchMove="OnHostTouchMove" TouchUp="OnHostTouchUp"
                    MouseMove="OnHostMouseMove">
                <TextBlock Text="把手掌按在任意处：绿色擦除区会实时变成和接触面积一样大"
                           Foreground="#FF808080" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="15" IsHitTestVisible="False" />
            </Border>
            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True" />
        </Grid>

        <!-- 右：参数 -->
        <Border Grid.Column="1" Width="340" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <TextBlock Text="面积擦预览" FontWeight="Bold" FontSize="15" Foreground="#FF1E1E1E" />
                    <TextBlock Text="读驱动上报的接触矩形 → 实时画出等大的擦除区（按多大，擦多大）"
                               TextWrapping="Wrap" Foreground="#FF666666" Margin="0,4,0,0" />

                    <TextBlock Text="接触来源：" Margin="0,6,0,0" Foreground="#FF444444" />
                    <ComboBox x:Name="SourceModeCombo" SelectedIndex="0" Margin="0,4,0,0" SelectionChanged="OnSourceModeChanged">
                        <ComboBoxItem Content="自适应（自动锁定）" />
                        <ComboBoxItem Content="原始HID（设备上报）" />
                        <ComboBoxItem Content="WPF TouchPoint.Bounds" />
                    </ComboBox>
                    <TextBlock x:Name="SourceInfoText" Text="当前来源: 无" Margin="0,6,0,0" FontFamily="Consolas"
                               FontSize="11" Foreground="#FF0A5A9A" TextWrapping="Wrap" />

                    <TextBlock x:Name="HidScaleText" Text="HID 计数标定: 未标定" Margin="0,6,0,0" FontFamily="Consolas"
                               FontSize="11" Foreground="#FF0A5A9A" TextWrapping="Wrap" />
                    <TextBlock Text="设备只给逻辑计数、不给物理单位时，用①的手掌面积标定「1 计数 = 多少 mm」"
                               TextWrapping="Wrap" FontSize="11" Foreground="#FF888888" Margin="0,2,0,0" />
                    <Button Content="标定 HID 计数→mm（用①的手掌面积）" Margin="0,6,0,0" Padding="4,3"
                            Click="OnCalibrateHidScale" />

                    <TextBlock Text="无触摸硬件时自测（手动比例 + 注入模拟计数）" Margin="0,12,0,0" TextWrapping="Wrap"
                               FontSize="11" Foreground="#FF888888" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="1 计数 =" VerticalAlignment="Center" />
                        <TextBox x:Name="ScaleInput" Width="56" Text="0.5" Margin="4,0" VerticalContentAlignment="Center" />
                        <TextBlock Text="mm" VerticalAlignment="Center" />
                        <Button Content="应用比例" Margin="8,0,0,0" Padding="8,2" Click="OnApplyManualScale" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="模拟计数 =" VerticalAlignment="Center" />
                        <TextBox x:Name="SimCountInput" Width="56" Text="200" Margin="4,0" VerticalContentAlignment="Center" />
                        <Button Content="注入" Margin="8,0,0,0" Padding="8,2" Click="OnInjectSyntheticCount" />
                    </StackPanel>

                    <TextBlock Text="擦除形状：" Margin="0,12,0,0" Foreground="#FF444444" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="ShapeRect" Content="矩形（默认）" GroupName="Shape" IsChecked="True" Checked="OnShapeChanged" />
                        <RadioButton x:Name="ShapeCircle" Content="正圆（等面积）" GroupName="Shape" Margin="12,0,0,0" Checked="OnShapeChanged" />
                    </StackPanel>

                    <GroupBox Header="倍率" Margin="0,12,0,0">
                        <StackPanel Margin="6">
                            <TextBlock Text="自动 = √(手掌面积 a ÷ 本页按压峰值 b)，自动计算" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#FF888888" />
                            <TextBlock x:Name="RatioText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                                       Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="…" />
                            <TextBlock Text="微调（在自动基础上再乘）" Margin="0,8,0,0" Foreground="#FF444444" />
                            <Slider x:Name="RatioTrimSlider" Minimum="0.5" Maximum="1.5" Value="1"
                                    TickFrequency="0.01" ValueChanged="OnRatioTrimChanged" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="面积阈值（手掌擦 / 书写）" Margin="0,10,0,0">
                        <StackPanel Margin="6">
                            <TextBlock Text="由标定自动得出：(手掌按压 + 手指按压) ÷ 2" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#FF888888" />
                            <TextBlock x:Name="AreaThresholdText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                                       Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="—" />
                            <TextBlock Text="微调" Margin="0,8,0,0" Foreground="#FF444444" />
                            <Slider x:Name="AreaTrimSlider" Minimum="0.5" Maximum="1.5" Value="1"
                                    TickFrequency="0.01" ValueChanged="OnAreaTrimChanged" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="压感阈值" Margin="0,10,0,0">
                        <StackPanel Margin="6">
                            <TextBlock Text="由手掌按压时的压感自动得出" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#FF888888" />
                            <TextBlock x:Name="PressureThresholdText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                                       Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="—" />
                            <TextBlock Text="微调" Margin="0,8,0,0" Foreground="#FF444444" />
                            <Slider x:Name="PressureTrimSlider" Minimum="0.5" Maximum="1.5" Value="1"
                                    TickFrequency="0.01" ValueChanged="OnPressureTrimChanged" />
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="FollowSizeCheck" Content="随接触尺寸变化（按多大擦多大）" IsChecked="True"
                              Margin="0,10,0,0" Checked="OnFollowSizeChanged" Unchecked="OnFollowSizeChanged" />
                    <CheckBox x:Name="FollowPressureCheck" Content="随压力变化（按多重擦多大）" IsChecked="False"
                              Margin="0,6,0,0" Checked="OnFollowPressureChanged" Unchecked="OnFollowPressureChanged" />
                    <CheckBox x:Name="AreaThresholdCheck" Content="启用面积阈值（关闭则永远手掌擦）" IsChecked="True"
                              Margin="0,10,0,0" Checked="OnAreaThresholdChanged" Unchecked="OnAreaThresholdChanged" />
                    <CheckBox x:Name="WritingPressureCheck" Content="书写启用压感（关闭则模拟 512/1024）" IsChecked="True"
                              Margin="0,6,0,0" Checked="OnWritingPressureChanged" Unchecked="OnWritingPressureChanged" />
                    <TextBlock x:Name="JudgeText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                               Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="判定：—" />
                    <Button Content="清除预览" Margin="0,10,0,0" Padding="4,3" Click="OnClearPreview" />

                    <TextBlock x:Name="EraserInfoText" Margin="0,12,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                               Foreground="#FF0A5A9A"
                               Text="在本页用真触摸屏按一下手掌，这里会实时显示接触面积与等大的擦除区。&#x0a;按住不放、改变按压轻重或手的角度，面积也会实时刷新（不抬手也变，取决于驱动是否上报）。" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
