<Window x:Class="TouchSuite.Ink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchSuite.Ink" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowState="Maximized"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp"
        PreviewMouseLeftButtonDown="OnPreviewPromotedMouse" PreviewMouseLeftButtonUp="OnPreviewPromotedMouse"
        StylusDown="OnStylusDown" StylusMove="OnStylusMove" StylusUp="OnStylusUp"
        TouchDown="OnTouchDown" TouchMove="OnTouchMove" TouchUp="OnTouchUp"
        SnapsToDevicePixels="True" UseLayoutRounding="False">
  <Window.Resources>
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Margin" Value="8,2" />
    </Style>
  </Window.Resources>

  <Grid>
    <!-- 回退墨迹层（只在 DComp 不可用时用到）；不参与命中测试 -->
    <Canvas x:Name="FallbackCanvas" IsHitTestVisible="False" />

    <!-- 落笔区：alpha=1 的近乎不可见背景 —— 分层窗口按 alpha 命中测试，
         真正全透明(alpha=0)的像素会把鼠标放过去，谁也点不到。
         鼠标模式下把这个 Border 收起（窗口其余像素 alpha=0），点击就穿到桌面；
         工具栏本身是不透明像素，所以仍然点得动。 -->
    <Border x:Name="InputSurface" Background="#01000000" />

    <!-- 工具栏（WPF 层，永远在墨迹层之上） -->
    <Border x:Name="ToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
            Background="#E61B1B20" CornerRadius="12" Padding="10,8">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="ModeMouse" Style="{StaticResource ToolToggle}" Content="鼠标模式" Click="OnModeMouse" />
        <ToggleButton x:Name="ModeAnnotate" Style="{StaticResource ToolToggle}" Content="批注模式" IsChecked="True" Click="OnModeAnnotate" />
        <Border Style="{StaticResource Divider}" />
        <TextBlock Text="输入源" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="4,0,6,0" FontSize="13" />
        <ToggleButton x:Name="InputSourceButton" Style="{StaticResource ToolToggle}" Content="WPF 事件"
                      Click="OnInputSourceToggle" />
        <Border Style="{StaticResource Divider}" />
        <ToggleButton x:Name="ToolPen" Style="{StaticResource ToolToggle}" Content="笔" IsChecked="True" Click="OnToolPen" />
        <ToggleButton x:Name="ToolEraser" Style="{StaticResource ToolToggle}" Content="橡皮" Click="OnToolEraser" />
        <Border Style="{StaticResource Divider}" />
        <Button Style="{StaticResource ToolButton}" Width="26" Background="#FF1A1A1A" Tag="#FF1A1A1A" Click="OnSwatch" />
        <Button Style="{StaticResource ToolButton}" Width="26" Background="#FFE23D3D" Tag="#FFE23D3D" Click="OnSwatch" />
        <Button Style="{StaticResource ToolButton}" Width="26" Background="#FF1E6FEB" Tag="#FF1E6FEB" Click="OnSwatch" />
        <Button Style="{StaticResource ToolButton}" Width="26" Background="#FF16A34A" Tag="#FF16A34A" Click="OnSwatch" />
        <Button Style="{StaticResource ToolButton}" Width="26" Background="#66FFE24D" Tag="#66FFE24D" Click="OnSwatch" />
        <Border Style="{StaticResource Divider}" />
        <TextBlock Text="粗细" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="4,0,6,0" FontSize="13" />
        <Slider x:Name="WidthSlider" Minimum="2" Maximum="32" Value="6" Width="110"
                VerticalAlignment="Center" ValueChanged="OnWidthChanged" />
        <Border Style="{StaticResource Divider}" />
        <Button Style="{StaticResource ToolButton}" Content="撤销" Click="OnUndo" />
        <Button Style="{StaticResource ToolButton}" Content="清空" Click="OnClear" />
        <Button Style="{StaticResource ToolButton}" Content="设置" Click="OnSettings" />
        <Button Style="{StaticResource ToolButton}" Content="退出" Click="OnExit" />
      </StackPanel>
    </Border>

    <!-- 输入源下拉：故意不用 ComboBox —— 它的弹出列表是独立 HWND，窗口排不进置顶带，
         永远压在墨迹窗口下面，超出工具栏那几项就点不到。放在本窗口内部就始终在墨迹层之上。 -->
    <Border x:Name="InputSourceMenu" Visibility="Collapsed"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="#F21B1B20" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="8" Padding="6">
      <StackPanel>
        <Button Style="{StaticResource ToolButton}" Tag="0" Width="200" HorizontalContentAlignment="Left"
                Background="#1FFFFFFF" BorderBrush="#33FFFFFF" Content="WPF 事件（现状）" Click="OnInputSourcePicked" />
        <Button Style="{StaticResource ToolButton}" Tag="1" Width="200" HorizontalContentAlignment="Left"
                Background="#1FFFFFFF" BorderBrush="#33FFFFFF" Content="RawInput 原始 HID" Click="OnInputSourcePicked" />
        <Button Style="{StaticResource ToolButton}" Tag="2" Width="200" HorizontalContentAlignment="Left"
                Background="#1FFFFFFF" BorderBrush="#33FFFFFF" Content="WM_POINTER 帧 API" Click="OnInputSourcePicked" />
        <Button Style="{StaticResource ToolButton}" Tag="3" Width="200" HorizontalContentAlignment="Left"
                Background="#1FFFFFFF" BorderBrush="#33FFFFFF" Content="组合 RawInput+POINTER" Click="OnInputSourcePicked" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" Foreground="#B3FFFFFF" FontSize="12"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,12" />
  </Grid>
</Window>
