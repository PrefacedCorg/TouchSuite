<Window x:Class="TouchSuite.Ink.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <CheckBox x:Name="ChkDComp" Content="DComp 墨迹层（GPU）" Margin="0,0,0,4" Click="OnToggle" />
    <TextBlock Text="关闭后改用 WPF 层，重启生效" Foreground="#FF777777" FontSize="11" Margin="24,0,0,12" />

    <CheckBox x:Name="ChkPrediction" Content="笔迹预测" Margin="0,0,0,12" Click="OnToggle" />
    <CheckBox x:Name="ChkSmoothing" Content="平滑（贝塞尔）" Margin="0,0,0,12" Click="OnToggle" />
    <CheckBox x:Name="ChkTaper" Content="笔锋（收笔渐细）" Margin="0,0,0,16" Click="OnToggle" />

    <Button Content="关闭" Width="80" Height="28" HorizontalAlignment="Right" Click="OnClose" />
  </StackPanel>
</Window>
