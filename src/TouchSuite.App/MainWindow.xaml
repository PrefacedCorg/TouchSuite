<Window x:Class="TouchSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:e="clr-namespace:TouchSuite.App.Eraser"
        Title="TouchSuite 校准向导" Height="900" Width="1220"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- 顶部信息栏：全程显示关键结果 -->
        <Border DockPanel.Dock="Top" Background="#FF1E1E1E" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="校准信息（全程显示）" Foreground="#FF7FD4FF" FontWeight="Bold" FontSize="14"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="HighPrecisionCheck" Content="高精度模式（后端双精度不取整 + 显示按有效位）"
                              Foreground="#FFE0E0E0" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="OnHighPrecisionChanged" Unchecked="OnHighPrecisionChanged" />
                    <CheckBox x:Name="ShowHidTableCheck" Content="显示原始HID映射表"
                              Foreground="#FFE0E0E0" IsChecked="False" Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="OnShowHidTableChanged" Unchecked="OnShowHidTableChanged" />
                </StackPanel>
                <TextBlock x:Name="InfoBar" Foreground="#FFE0E0E0" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,0" Text="正在读取 EDID ..." />
            </StackPanel>
        </Border>

        <!-- 底部导航 -->
        <Border DockPanel.Dock="Bottom" Background="#FFF3F3F3" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StepTitle" DockPanel.Dock="Left" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="#FF1E1E1E" Text="选择路线" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF666666" Margin="0,0,16,0" />
                    <Button x:Name="BackBtn" Content="上一步" Click="OnBack" Padding="16,4" Margin="0,0,8,0" />
                    <Button x:Name="NextBtn" Content="下一步" Click="OnNext" Padding="24,4"
                            Background="#FF33CCFF" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 步骤内容 -->
        <Grid Margin="16">

            <!-- ⓪ 选路线：路线一=描摹（推荐），路线二=屏幕标定 -->
            <Grid x:Name="StepRoute" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="选择校准路线" FontSize="22" FontWeight="Bold" Foreground="#FF1E1E1E" />
                    <TextBlock Text="两条路线任选一条即可，不用都做。都用于得到「手掌像素面积」（K 的分子）。"
                               Foreground="#FF888888" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                        <Button x:Name="RouteTraceBtn" Click="OnPickTraceRoute" Width="440" Height="200"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="20" Background="#FFEFFFF1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="路线一 · 直接描摹手掌" FontSize="18" FontWeight="Bold" Foreground="#FF0F5132" />
                                    <Border Background="#FF16A34A" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="推荐" Foreground="White" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF333333"
                                           Text="直接在屏幕上沿手掌外轮廓描一圈，宽高自动得出，直接换算成像素面积。不用做屏幕标定。" />
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF888888" FontSize="12"
                                           Text="最省心。" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RouteScreenBtn" Click="OnPickScreenRoute" Width="440" Height="200" Margin="20,0,0,0"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="20" Background="#FFEDF6FF">
                            <StackPanel>
                                <TextBlock Text="路线二 · 屏幕标定 → 手掌尺寸" FontSize="18" FontWeight="Bold" Foreground="#FF11456B" />
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF333333"
                                           Text="先用 EDID / 画 10cm 线 / 填对角线 求出「毫米每像素」，再把默认 12cm × 18cm（可改）的手掌换算成像素面积。" />
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF888888" FontSize="12"
                                           Text="适合：知道屏幕尺寸、不想描摹手掌。" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 第二步 · 步骤1：选屏幕标定方式（三个框） -->
            <StackPanel x:Name="StepScreenPick" Visibility="Collapsed">
                <TextBlock Text="选择屏幕标定方式" FontSize="22" FontWeight="Bold" Foreground="#FF1E1E1E" />
                <TextBlock Text="三种任选一种即可；如果方式 1 量出来两个都不准，可以回来换方式 2 或 3。"
                           Foreground="#FF888888" Margin="0,8,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button x:Name="ScreenPickEdid" Click="OnPickScreenEdid" Width="280" Height="170"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="16" Background="#FFEDF6FF">
                        <StackPanel>
                            <TextBlock Text="方式 1 · EDID 核对" FontSize="17" FontWeight="Bold" Foreground="#FF11456B" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF333333"
                                       Text="读屏幕 EDID 尺寸，用真尺子核对横 / 竖 10cm 是否准。" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScreenPickDraw" Click="OnPickScreenDraw" Width="280" Height="170" Margin="16,0,0,0"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="16" Background="#FFFFF7E6">
                        <StackPanel>
                            <TextBlock Text="方式 2 · 画 10cm 线" FontSize="17" FontWeight="Bold" Foreground="#FF7A5B10" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF333333"
                                       Text="把真尺子贴在屏幕上，拖一条正好 10cm 的线来标定。" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScreenPickDiag" Click="OnPickScreenDiag" Width="280" Height="170" Margin="16,0,0,0"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="16" Background="#FFEDF6FF">
                        <StackPanel>
                            <TextBlock Text="方式 3 · 对角英寸" FontSize="17" FontWeight="Bold" Foreground="#FF11456B" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF333333"
                                       Text="直接填屏幕对角线英寸，按分辨率推算物理宽高。" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 第二步 · 步骤2：按所选方式标定 -->
            <ScrollViewer x:Name="StepScreen" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly" PanningRatio="2">
                <StackPanel>
                    <TextBlock x:Name="ScreenModeTitle" Text="屏幕标定" FontSize="16" FontWeight="Bold" />

                    <!-- ① EDID 核对 -->
                    <StackPanel x:Name="ScreenEdidPanel" Margin="0,12,0,0">
                        <StackPanel x:Name="EdidPickPanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="检测到多块在用显示器，选你正在量的这块 EDID：" VerticalAlignment="Center" FontSize="14" />
                            <ComboBox x:Name="EdidCombo" Width="220" Margin="10,0,0,0" SelectionChanged="OnEdidPicked" />
                        </StackPanel>
                        <TextBlock Text="用一把真尺子量屏幕上这条横线，是不是 10 cm？（每 1mm 一格，每 1cm 加粗并标数字）" FontSize="15" TextWrapping="Wrap" />
                        <Canvas x:Name="RulerH" Height="120" Margin="0,10,0,0" Background="#FFFBFBFB" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="横向 10cm：" VerticalAlignment="Center" FontSize="15" />
                            <RadioButton x:Name="HWideOk" Content="准" GroupName="hw" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="HWideNo" Content="不准" GroupName="hw" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="再量屏幕上这条竖线，是不是 10 cm？" FontSize="15" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Canvas x:Name="RulerV" Height="360" Width="200" Background="#FFFBFBFB" HorizontalAlignment="Left" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="纵向 10cm：" VerticalAlignment="Center" FontSize="15" />
                            <RadioButton x:Name="VWideOk" Content="准" GroupName="vw" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="VWideNo" Content="不准" GroupName="vw" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ② 画 10cm -->
                    <Grid x:Name="ScreenDrawPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="460" Background="#FFF4F4F4" BorderBrush="#FFBBBBBB" BorderThickness="1">
                            <Canvas x:Name="DrawCanvas" Background="Transparent" ClipToBounds="True"
                                    MouseLeftButtonDown="OnDrawDown" MouseMove="OnDrawMove" MouseLeftButtonUp="OnDrawUp" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="把真尺子贴在屏幕上，在左边灰框里按住鼠标拖出一条【正好 10 cm】的线段 —— 横、竖都行，画斜了会自动摆正到较长的那一边"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DrawInfoText" Text="尚未画线。" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel x:Name="FineTunePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="微调（拨到红虚线与尺子上的 10cm 对齐）：" TextWrapping="Wrap" />
                                <Slider x:Name="FineTuneSlider" Minimum="0.90" Maximum="1.10" Value="1.00"
                                        ValueChanged="OnFineTuneChanged" Margin="0,6,0,0" />
                                <TextBlock x:Name="FineTuneText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12" />
                                <Button Content="应用此标定" Margin="0,10,0,0" Padding="12,3" Click="OnApplyDrawn" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ③ 对角线 -->
                    <StackPanel x:Name="ScreenDiagPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="填屏幕对角线英寸（按分辨率比例推物理宽高，方形像素）" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="DiagonalInput" Width="70" Text="15.6" VerticalContentAlignment="Center" />
                            <TextBlock Text=" 英寸" VerticalAlignment="Center" />
                            <Button Content="应用对角线" Margin="8,0,0,0" Padding="12,3" Click="OnApplyDiagonal" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="ModeText" FontFamily="Consolas" FontSize="14" Margin="0,14,0,0"
                               Foreground="#FF0A5A9A" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- 路线一 · 步骤2：手掌物理尺寸（厘米） -->
            <StackPanel x:Name="StepPalmCm" Visibility="Collapsed">
                <TextBlock Text="手掌物理尺寸（默认宽 12cm × 高 18cm，可改）" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="按当前「毫米/像素」换算成像素面积（K 的分子）。"
                           Foreground="#FF888888" Margin="0,8,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="宽 cm" VerticalAlignment="Center" FontSize="15" />
                    <TextBox x:Name="PalmCmWidth" Width="80" Text="12" Margin="8,0,0,0" FontSize="14"
                             VerticalContentAlignment="Center" TextChanged="OnPalmCmChanged" />
                    <TextBlock Text="高 cm" VerticalAlignment="Center" FontSize="15" Margin="24,0,0,0" />
                    <TextBox x:Name="PalmCmHeight" Width="80" Text="18" Margin="8,0,0,0" FontSize="14"
                             VerticalContentAlignment="Center" TextChanged="OnPalmCmChanged" />
                </StackPanel>
                <TextBlock x:Name="PalmCmResult" FontFamily="Consolas" FontSize="13" Margin="0,18,0,0"
                           Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="—" />
            </StackPanel>

            <!-- 路线二 · 描摹手掌（左描摹 / 右填数） -->
            <Grid x:Name="StepPalmTrace" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="沿手掌外轮廓一笔描一圈（含手指）：宽高自动填右侧；也可直接在右侧填数值"
                                   Foreground="#FFB0B0B0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
                        <InkCanvas x:Name="TraceCanvas" Background="Transparent" StrokeCollected="OnStrokeCollected" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="手掌尺寸（物理像素 px）" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="宽 a2（横向，px）" Margin="0,10,0,2" Foreground="#FF444444" />
                    <TextBox x:Name="PalmWidthInput" Text="120" VerticalContentAlignment="Center" TextChanged="OnPalmSizeChanged" />
                    <TextBlock Text="高 a1（纵向，px）" Margin="0,10,0,2" Foreground="#FF444444" />
                    <TextBox x:Name="PalmHeightInput" Text="180" VerticalContentAlignment="Center" TextChanged="OnPalmSizeChanged" />
                    <Button Content="清除描摹" Margin="0,12,0,0" Padding="4,3" Click="OnClearTrace" />
                    <TextBlock x:Name="PalmSizeText" Margin="0,14,0,0" FontFamily="Consolas" FontSize="12"
                               Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="面积：—" />
                </StackPanel>
            </Grid>

            <!-- 手掌按一下（两条路线共用） -->
            <Grid x:Name="Step4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="15" TextWrapping="Wrap"
                           Text="按你平时「手掌擦」的姿势，把整只手掌按在下面黑区上并保持一下，然后点「记录手掌」。可多按几次，程序会自动取中值。"
                           Margin="0,0,0,10" />
                <Grid Grid.Row="1">
                    <Border x:Name="PalmHost" Background="#FF141414">
                        <TextBlock Text="把整只手掌按在这里" Foreground="#FF808080"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Background="#CCFFFFFF" Padding="10">
                        <StackPanel>
                            <TextBlock Text="接触来源：" FontSize="12" Foreground="#FF444444" />
                            <ComboBox x:Name="PalmSourceCombo" SelectedIndex="0" Margin="0,2,0,0"
                                      SelectionChanged="OnPalmSourceModeChanged">
                                <ComboBoxItem Content="自适应（自动锁定）" />
                                <ComboBoxItem Content="原始HID（设备上报尺寸）" />
                                <ComboBoxItem Content="软件WPF（系统接触框 + 软件推算）" />
                            </ComboBox>
                            <StackPanel x:Name="PalmHidMmPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="HID 触摸屏（多块时用哪一块）：" FontSize="12" Foreground="#FF444444" />
                                <ComboBox x:Name="PalmHidDeviceCombo" SelectedIndex="0" Margin="0,2,0,0"
                                          SelectionChanged="OnPalmHidDeviceChanged">
                                    <ComboBoxItem Content="自动（第一块出数的触摸屏）" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="PalmSourceInfoText" FontFamily="Consolas" FontSize="11"
                                       Margin="0,4,0,0" Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="当前生效：—" />
                            <TextBlock x:Name="PalmLiveText" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" Text="实时：—" />
                            <TextBlock x:Name="PalmPeakText" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" Text="本次峰值：—&#x0a;记录后开始测下一次（建议多按几次取中值）" />
                            <Button Content="记录手掌" Margin="0,10,0,0" Padding="10,4" Click="OnRecordPalm" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 手指按一下 -->
            <Grid x:Name="Step5" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="15" TextWrapping="Wrap"
                           Text="再用一根手指按在下面黑区上（正常书写的力度），然后点「记录手指」。" Margin="0,0,0,10" />
                <Grid Grid.Row="1">
                    <Border x:Name="FingerHost" Background="#FF141414">
                        <TextBlock Text="用一根手指按在这里" Foreground="#FF808080"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Background="#CCFFFFFF" Padding="10">
                        <StackPanel>
                            <TextBlock Text="接触来源：" FontSize="12" Foreground="#FF444444" />
                            <ComboBox x:Name="FingerSourceCombo" SelectedIndex="0" Margin="0,2,0,0"
                                      SelectionChanged="OnFingerSourceModeChanged">
                                <ComboBoxItem Content="自适应（自动锁定）" />
                                <ComboBoxItem Content="原始HID（设备上报尺寸）" />
                                <ComboBoxItem Content="软件WPF（系统接触框 + 软件推算）" />
                            </ComboBox>
                            <StackPanel x:Name="FingerHidMmPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="HID 触摸屏（多块时用哪一块）：" FontSize="12" Foreground="#FF444444" />
                                <ComboBox x:Name="FingerHidDeviceCombo" SelectedIndex="0" Margin="0,2,0,0"
                                          SelectionChanged="OnFingerHidDeviceChanged">
                                    <ComboBoxItem Content="自动（第一块出数的触摸屏）" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="FingerSourceInfoText" FontFamily="Consolas" FontSize="11"
                                       Margin="0,4,0,0" Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="当前生效：—" />
                            <TextBlock x:Name="FingerLiveText" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" Text="实时：—" />
                            <TextBlock x:Name="FingerPeakText" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" Text="本次峰值：—&#x0a;记录后开始测下一次（建议多按几次取中值）" />
                            <Button Content="记录手指" Margin="0,10,0,0" Padding="10,4" Click="OnRecordFinger" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 结果 + 面积擦预览 -->
            <Grid x:Name="Step6" Visibility="Collapsed">
                <e:EraserPreviewPage x:Name="EraserPage" />
            </Grid>

        </Grid>
    </DockPanel>
</Window>
