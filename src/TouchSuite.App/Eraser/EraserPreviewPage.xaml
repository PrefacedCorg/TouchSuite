<UserControl x:Class="TouchSuite.App.Eraser.EraserPreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左：预览区 -->
        <Grid Grid.Column="0">
            <Border x:Name="Host" Background="#FF101010">
                <TextBlock Text="用真触摸屏按一下：绿色擦除区 = 接触尺寸 × K"
                           Foreground="#FF808080" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="15" IsHitTestVisible="False" />
            </Border>
            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True" />
        </Grid>

        <!-- 右：来源 / 保存 / 触摸信息（原中栏）在最上面，下面是全部参数 -->
        <Border Grid.Column="1" Width="470" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="12">
                <StackPanel>
                    <TextBlock Text="面积擦预览" FontWeight="Bold" FontSize="15" Foreground="#FF1E1E1E" />

                    <TextBlock Text="接触来源" Margin="0,10,0,0" Foreground="#FF444444" />
                    <ComboBox x:Name="SourceModeCombo" SelectedIndex="0" Margin="0,4,0,0"
                              SelectionChanged="OnSourceModeChanged">
                        <ComboBoxItem Content="自适应（自动锁定）" />
                        <ComboBoxItem Content="原始HID（设备上报尺寸）" />
                        <ComboBoxItem Content="软件WPF（系统接触框）" />
                    </ComboBox>
                    <StackPanel x:Name="HidDevicePanel" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="HID 触摸屏（多块时用哪一块）" Foreground="#FF444444" />
                        <ComboBox x:Name="HidDeviceCombo" SelectedIndex="0" Margin="0,2,0,0"
                                  SelectionChanged="OnHidDeviceChanged">
                            <ComboBoxItem Content="自动（第一块出数的触摸屏）" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="SourceInfoText" Text="当前来源: 无" Margin="0,6,0,0" FontFamily="Consolas"
                               FontSize="11" Foreground="#FF0A5A9A" TextWrapping="Wrap" />

                    <Border Height="1" Background="#FFCCCCCC" Margin="0,12,0,10" />
                    <Button Content="保存结果到文件" Padding="14,5" HorizontalAlignment="Left" Click="OnSaveRequested" />
                    <TextBlock x:Name="SavePathText" Margin="0,8,0,0" FontSize="11"
                               Foreground="#FF888888" TextWrapping="Wrap" />

                    <Expander Header="触摸信息" Margin="0,14,0,0" IsExpanded="False" Foreground="#FF1E1E1E">
                        <Border Background="#FFEDEDED" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="8"
                                Margin="0,6,0,0">
                            <TextBlock x:Name="HidInfoText" FontFamily="Consolas" FontSize="11"
                                       Foreground="#FF0A5A9A" TextWrapping="Wrap"
                                       Text="按一下后显示来源 / 坐标 / 尺寸 / 压感 / 换算明细。" />
                        </Border>
                    </Expander>

                    <Border Height="1" Background="#FFCCCCCC" Margin="0,14,0,10" />

                    <!-- K 定值 -->
                    <GroupBox Header="K 定值">
                        <StackPanel Margin="6">
                            <TextBlock x:Name="KText" FontFamily="Consolas" FontSize="12"
                                       Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="…" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="K 倍率" VerticalAlignment="Center" Foreground="#FF444444" />
                                <Slider x:Name="KTrimSlider" Grid.Column="1" Minimum="0.5" Maximum="2" Value="1"
                                        TickFrequency="0.01" Margin="8,0,0,0" ValueChanged="OnKTrimChanged" />
                                <Button Grid.Column="2" Content="恢复" Padding="6,1" FontSize="11" Margin="8,0,0,0"
                                        Click="OnResetKTrim" />
                            </Grid>
                            <TextBlock x:Name="KTrimValueText" FontSize="11" Foreground="#FF666666" Text="×1.00" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 擦 / 写 切换阈值 -->
                    <GroupBox Header="擦 / 写 切换阈值">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="AreaThresholdCheck" Content="启用面积阈值（关闭 → 一律手掌擦）"
                                      IsChecked="True" Checked="OnAreaThresholdCheckChanged"
                                      Unchecked="OnAreaThresholdCheckChanged" />
                            <StackPanel x:Name="AreaThresholdDetailPanel" Margin="0,6,0,0">
                                <TextBlock x:Name="AreaThresholdText" FontFamily="Consolas" FontSize="12"
                                           Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="—" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="AreaThresholdSlider" Grid.Column="0" Minimum="0" Maximum="1" Value="0"
                                            TickFrequency="1" ValueChanged="OnAreaThresholdSliderChanged" />
                                    <Button Grid.Column="1" Content="恢复" Padding="6,1" FontSize="11" Margin="8,0,0,0"
                                            Click="OnResetAreaThreshold" />
                                </Grid>
                                <TextBlock x:Name="AreaThresholdValueText" FontSize="11" Foreground="#FF666666" Text="—" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 手掌擦（尺寸跟随 + 限制 + 锁定 + 压感） -->
                    <GroupBox Header="手掌擦">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="FollowSizeCheck" Content="随触摸尺寸（按多大擦多大）" IsChecked="True"
                                      Checked="OnFollowSizeChanged" Unchecked="OnFollowSizeChanged" />
                            <StackPanel x:Name="PalmLimitPanel" Orientation="Horizontal" Margin="16,4,0,0">
                                <TextBlock Text="限制" VerticalAlignment="Center" Foreground="#FF444444" />
                                <RadioButton x:Name="PalmLimitNone" Content="不限" GroupName="PalmLimit"
                                             Margin="8,0,0,0" Checked="OnPalmLimitChanged" />
                                <RadioButton x:Name="PalmLimitFloor" Content="下限" GroupName="PalmLimit"
                                             Margin="8,0,0,0" IsChecked="True" Checked="OnPalmLimitChanged" />
                                <RadioButton x:Name="PalmLimitCap" Content="上限" GroupName="PalmLimit"
                                             Margin="8,0,0,0" Checked="OnPalmLimitChanged" />
                            </StackPanel>
                            <CheckBox x:Name="LockPalmSizeCheck" Content="擦时只增不减" IsChecked="False"
                                      Margin="0,4,0,0" Checked="OnLockPalmSizeChanged" Unchecked="OnLockPalmSizeChanged" />
                            <CheckBox x:Name="MultiTouchPalmCheck" Content="多触点求和（多点 = 手掌擦）" IsChecked="True"
                                      Margin="0,4,0,0" Checked="OnMultiTouchPalmChanged" Unchecked="OnMultiTouchPalmChanged" />
                            <CheckBox x:Name="PalmPressureCheck" Content="启用压感" IsChecked="True"
                                      Margin="0,4,0,0" Checked="OnPalmPressureChanged" Unchecked="OnPalmPressureChanged" />
                            <StackPanel x:Name="PalmPressureDetailPanel" Margin="16,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="阈值" VerticalAlignment="Center" Foreground="#FF444444" />
                                    <Slider x:Name="PalmThrSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                            TickFrequency="0.01" Margin="8,0,0,0" ValueChanged="OnPalmThrChanged" />
                                    <Button Grid.Column="2" Content="恢复" Padding="6,1" FontSize="11" Margin="8,0,0,0"
                                            Click="OnResetPalmThr" />
                                </Grid>
                                <TextBlock x:Name="PalmThrValueText" FontSize="11" Foreground="#FF666666" Text="0.50" Margin="40,0,0,0" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大放大" VerticalAlignment="Center" Foreground="#FF444444" />
                                    <Slider x:Name="PalmMaxSlider" Grid.Column="1" Minimum="1" Maximum="3" Value="2"
                                            TickFrequency="0.05" Margin="8,0,0,0" ValueChanged="OnPalmMaxChanged" />
                                    <Button Grid.Column="2" Content="恢复" Padding="6,1" FontSize="11" Margin="8,0,0,0"
                                            Click="OnResetPalmMax" />
                                </Grid>
                                <TextBlock x:Name="PalmMaxValueText" FontSize="11" Foreground="#FF666666" Text="×2.00" Margin="40,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 书写（未启用阈值时整块隐藏） -->
                    <GroupBox x:Name="WritingSection" Header="书写">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="WritingPressureCheck" Content="启用压感" IsChecked="True"
                                      Checked="OnWritingPressureChanged" Unchecked="OnWritingPressureChanged" />
                            <StackPanel x:Name="WritingPressureDetailPanel" Margin="16,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="阈值" VerticalAlignment="Center" Foreground="#FF444444" />
                                    <Slider x:Name="WritingThrSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                            TickFrequency="0.01" Margin="8,0,0,0" ValueChanged="OnWritingThrChanged" />
                                    <Button Grid.Column="2" Content="恢复" Padding="6,1" FontSize="11" Margin="8,0,0,0"
                                            Click="OnResetWritingThr" />
                                </Grid>
                                <TextBlock x:Name="WritingThrValueText" FontSize="11" Foreground="#FF666666" Text="0.50" Margin="40,0,0,0" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大放大" VerticalAlignment="Center" Foreground="#FF444444" />
                                    <Slider x:Name="WritingMaxSlider" Grid.Column="1" Minimum="1" Maximum="3" Value="2"
                                            TickFrequency="0.05" Margin="8,0,0,0" ValueChanged="OnWritingMaxChanged" />
                                    <Button Grid.Column="2" Content="恢复" Padding="6,1" FontSize="11" Margin="8,0,0,0"
                                            Click="OnResetWritingMax" />
                                </Grid>
                                <TextBlock x:Name="WritingMaxValueText" FontSize="11" Foreground="#FF666666" Text="×2.00" Margin="40,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="WritingFollowSizeCheck" Content="书写也随触摸尺寸" IsChecked="False"
                                      Margin="0,4,0,0" Checked="OnWritingFollowSizeChanged"
                                      Unchecked="OnWritingFollowSizeChanged" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 形状 / 长宽比 -->
                    <GroupBox Header="擦除区形状 · 长宽比">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ShapeRect" Content="矩形" GroupName="Shape" IsChecked="True"
                                             Checked="OnShapeChanged" />
                                <RadioButton x:Name="ShapeCircle" Content="椭圆" GroupName="Shape"
                                             Margin="16,0,0,0" Checked="OnShapeChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="AspectContact" Content="跟随触摸尺寸" GroupName="Aspect"
                                             IsChecked="True" Checked="OnAspectChanged" />
                                <RadioButton x:Name="AspectTrace" Content="手掌描摹" GroupName="Aspect"
                                             Margin="16,0,0,0" Checked="OnAspectChanged" />
                                <RadioButton x:Name="AspectCustom" Content="自定义" GroupName="Aspect"
                                             Margin="16,0,0,0" Checked="OnAspectChanged" />
                            </StackPanel>
                            <TextBlock x:Name="AspectTraceHint" Margin="16,2,0,0" FontSize="11" Foreground="#FFAA6600"
                                       TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="「手掌描摹」需要先有手掌尺寸（描摹手掌 / 填 cm）。" />
                            <StackPanel x:Name="AspectCustomPanel" Orientation="Horizontal" Margin="16,6,0,0"
                                        Visibility="Collapsed">
                                <TextBox x:Name="AspectWInput" Width="52" Text="9" TextChanged="OnAspectTextChanged"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text=" : " VerticalAlignment="Center" />
                                <TextBox x:Name="AspectHInput" Width="52" Text="14" TextChanged="OnAspectTextChanged"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="（W : H）" VerticalAlignment="Center" Foreground="#FF888888"
                                           FontSize="11" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="SizeScalePanel" Margin="0,6,0,0">
                                <TextBlock Text="触摸比例（只在「跟随触摸尺寸」时生效）" Foreground="#FF444444" />
                                <ComboBox x:Name="SizeScaleCombo" SelectedIndex="0" Margin="0,2,0,0"
                                          SelectionChanged="OnSizeScaleChanged">
                                    <ComboBoxItem Content="归一（按屏幕拉伸）" />
                                    <ComboBoxItem Content="不归一（1:1）" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 通用 -->
                    <CheckBox x:Name="SmoothJitterCheck" Content="平滑抖动（防闪）" IsChecked="True"
                              Margin="0,10,0,0" Checked="OnSmoothJitterChanged" Unchecked="OnSmoothJitterChanged" />

                    <!-- 状态 -->
                    <TextBlock x:Name="PressureInfoText" Margin="0,10,0,0" FontFamily="Consolas" FontSize="11"
                               Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="压感：—" />
                    <TextBlock x:Name="JudgeText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                               Foreground="#FF0A5A9A" TextWrapping="Wrap" Text="判定：—" />
                    <Button Content="清除预览" Margin="0,10,0,0" Padding="4,3" HorizontalAlignment="Left"
                            Click="OnClearPreview" />
                    <TextBlock x:Name="EraserInfoText" Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                               Foreground="#FF0A5A9A" Text="—" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
