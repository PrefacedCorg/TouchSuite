<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TouchSuite.Receiver</RootNamespace>
    <AssemblyName>TouchSuite.Receiver</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- app.manifest 里的 PerMonitorV2 必须保留：注入坐标要求物理像素。
         WinForms 会就此警告 WFO0003，此处按需忽略（主界面仍是控制台）。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>1.0.0</Version>
    <Product>TouchSuite Receiver</Product>
  </PropertyGroup>

</Project>
