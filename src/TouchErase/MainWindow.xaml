<Window x:Class="TouchErase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchErase · 手掌擦矫正 Demo"
        Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        DpiChanged="OnDpiChanged">
    <Grid>
        <DockPanel>

            <StatusBar DockPanel.Dock="Bottom">
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBar>

            <!-- 顶部：校准信息 -->
            <Border x:Name="CalibPanel" DockPanel.Dock="Top" Background="#FF1E1E1E" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="屏幕物理尺寸校准" Foreground="#FF7FD4FF" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="CalibInfoText" Foreground="#FFE0E0E0" FontFamily="Consolas"
                                   Margin="0,4,0,0" TextWrapping="Wrap" Text="正在读取 EDID ..." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="引导" Click="OnStartGuide" Padding="14,6"
                            VerticalAlignment="Center" Background="#FF33CCFF" FontWeight="Bold" />
                </Grid>
            </Border>

            <!-- 右侧：控制面板 -->
            <Border DockPanel.Dock="Right" Width="330" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>

                        <GroupBox Header="屏幕校准（EDID）" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <TextBlock Text="EDID 读不到时可手动填对角线英寸："
                                           TextWrapping="Wrap" Foreground="#FF444444" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox x:Name="DiagInput" Width="70" Text="15.6" VerticalContentAlignment="Center" />
                                    <TextBlock Text=" 英寸" VerticalAlignment="Center" />
                                    <Button Content="应用" Margin="10,0,0,0" Padding="12,2" Click="OnApplyDiagonal" />
                                </StackPanel>
                                <Button Content="重新读取 EDID" Margin="0,8,0,0" Padding="4,3" Click="OnReloadEdid" />

                                <TextBlock Text="EDID 尺寸推算方式：" Margin="0,10,0,0" Foreground="#FF444444" />
                                <ComboBox x:Name="EdidModeCombo" SelectedIndex="1" SelectionChanged="OnEdidModeChanged">
                                    <ComboBoxItem Content="横竖都按 EDID（原样）" />
                                    <ComboBoxItem Content="按宽推竖（方形像素）" />
                                    <ComboBoxItem Content="按竖推宽（方形像素）" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="① 手掌尺寸（面积 a）" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <TextBlock x:Name="TraceInfoText" Text="方式一：在「① 描摹手掌轮廓」页按住笔/鼠标描一圈；方式二：直接量手宽×手长（更准）。以最后一次操作为准。"
                                           TextWrapping="Wrap" Foreground="#FF444444" />
                                <Button x:Name="ComputeAreaButton" Content="计算手掌面积（凸包+Shoelace）"
                                        Margin="0,8,0,0" Padding="4,3" Click="OnComputeArea" />
                                <Button Content="清除描摹" Margin="0,6,0,0" Padding="4,3" Click="OnClearTrace" />

                                <TextBlock Text="或：手宽 × 手长（cm）" Margin="0,10,0,0" Foreground="#FF444444" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="HandWidthInput" Width="48" Text="12" VerticalContentAlignment="Center" />
                                    <TextBlock Text=" × " VerticalAlignment="Center" />
                                    <TextBox x:Name="HandHeightInput" Width="48" Text="18" VerticalContentAlignment="Center" />
                                    <TextBlock Text=" cm" VerticalAlignment="Center" />
                                    <Button Content="应用尺寸" Margin="10,0,0,0" Padding="12,2" Click="OnApplyHandSize" />
                                </StackPanel>

                                <TextBlock x:Name="PalmSizeText" Margin="0,8,0,0" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12" Foreground="#FF0A5A9A"
                                           Text="尚未设定手掌尺寸。" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="② 手掌接触面积" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <TextBlock Text="在「② 手掌接触面积」页把整只手按上去：这里显示当前接触尺寸，以及本次按压的峰值（手掌接触面积取峰值，不取松手时的值）。"
                                           TextWrapping="Wrap" Foreground="#FF444444" />
                                <TextBlock x:Name="ContactInfoText" Margin="0,8,0,0" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12" Foreground="#FF0A5A9A"
                                           Text="尚未读到接触尺寸。" />
                            </StackPanel>
                        </GroupBox>

                        <TextBlock x:Name="ResultText" Text="" TextWrapping="Wrap" FontFamily="Consolas"
                                   Foreground="#FF00A85A" FontSize="12" Margin="2,4,2,10" />

                        <GroupBox Header="日志" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <CheckBox x:Name="LogEnabledCheck" Content="记录到日志文件" IsChecked="True"
                                          Checked="OnLogEnabledChanged" Unchecked="OnLogEnabledChanged" />
                                <CheckBox x:Name="LogFramesCheck" Content="逐帧记录 HID Bounds（诊断用，量较大）"
                                          IsChecked="True" Margin="0,4,0,0"
                                          Checked="OnLogFramesChanged" Unchecked="OnLogFramesChanged" />
                                <TextBlock x:Name="LogPathText" Text="日志未初始化" TextWrapping="Wrap"
                                           FontSize="11" Foreground="#FF666666" Margin="0,6,0,0" />
                                <Button Content="打开日志文件夹" Margin="0,6,0,0" Padding="4,3" Click="OnOpenLogFolder" />
                                <Button Content="HID 触摸诊断（写日志）" Margin="0,6,0,0" Padding="4,3" Click="OnHidDiagnostics" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中部：两步操作 -->
            <TabControl x:Name="StageTabs" Margin="6">
                <TabItem Header="① 描摹手掌轮廓">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Background="#FFF7F7F7">
                            <TextBlock Text="参考标尺：横向 / 纵向 均按 EDID 物理尺寸换算，请用直尺目测核对"
                                       Margin="6,4" Foreground="#FF444444" />
                            <Canvas x:Name="RulerCanvas" Height="66" ClipToBounds="True" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Canvas x:Name="RulerCanvasV" Grid.Column="0" Background="#FFF7F7F7"
                                    ClipToBounds="True" />

                            <Grid Grid.Column="1" Background="White">
                                <TextBlock Text="在此把手掌连手指一起描一圈（笔或鼠标）" Foreground="#FFB0B0B0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                                <InkCanvas x:Name="TraceCanvas" Background="Transparent"
                                           StrokeCollected="OnStrokeCollected" />
                                <Canvas x:Name="TraceOverlay" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="② 手掌接触面积">
                    <Grid>
                        <Border x:Name="ContactHost" Background="#FF1B1B1B"
                                TouchDown="OnContactTouchDown" TouchMove="OnContactTouchMove" TouchUp="OnContactTouchUp"
                                MouseLeftButtonDown="OnContactMouseDown" MouseMove="OnContactMouseMove">
                            <TextBlock Text="把整只手（含手指）按在黑区上 → 右侧显示当前接触尺寸与本次按压峰值"
                                       Foreground="#FF808080" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="15" />
                        </Border>
                        <Canvas x:Name="ContactOverlay" IsHitTestVisible="False" />
                    </Grid>
                </TabItem>

                <TabItem Header="③ 面积擦预览">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Border x:Name="EraserHost" Background="#FF101010"
                                    TouchDown="OnEraserTouchDown" TouchMove="OnEraserTouchMove" TouchUp="OnEraserTouchUp">
                                <TextBlock Text="把手掌按在屏幕任意处：绿色擦除区会实时变成和接触面积一样大"
                                           Foreground="#FF808080" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="15" />
                            </Border>
                            <Canvas x:Name="EraserOverlay" IsHitTestVisible="False" />
                        </Grid>

                        <Border Grid.Column="1" Width="330" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC"
                                BorderThickness="1,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="面积擦预览" FontWeight="Bold" FontSize="15" Foreground="#FF1E1E1E" />
                                    <TextBlock Text="读驱动上报的接触矩形 → 实时画出等大的擦除区（按多大，擦多大）"
                                               TextWrapping="Wrap" Foreground="#FF666666" Margin="0,4,0,0" />
                                    <TextBlock Text="接触来源：" Margin="0,6,0,0" Foreground="#FF444444" />
                                    <ComboBox x:Name="SourceModeCombo" SelectedIndex="0" Margin="0,4,0,0"
                                              SelectionChanged="OnSourceModeChanged">
                                        <ComboBoxItem Content="自适应（自动锁定）" />
                                        <ComboBoxItem Content="原始HID（设备上报）" />
                                        <ComboBoxItem Content="WM_POINTER rcContact" />
                                        <ComboBoxItem Content="WPF TouchPoint.Bounds" />
                                    </ComboBox>
                                    <TextBlock x:Name="SourceInfoText" Text="当前来源: 无" Margin="0,6,0,0"
                                               FontFamily="Consolas" FontSize="11" Foreground="#FF0A5A9A"
                                               TextWrapping="Wrap" />

                                    <TextBlock x:Name="HidScaleText" Text="HID 计数标定: 未标定" Margin="0,6,0,0"
                                               FontFamily="Consolas" FontSize="11" Foreground="#FF0A5A9A"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="设备只给逻辑计数、不给物理单位时，用①的手掌面积标定「1 计数 = 多少 mm」"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#FF888888" Margin="0,2,0,0" />
                                    <Button Content="标定 HID 计数→mm（用①的手掌面积）" Margin="0,6,0,0" Padding="4,3"
                                            Click="OnCalibrateHidScale" />

                                    <TextBlock Text="无触摸硬件时自测（手动比例 + 注入模拟计数）" Margin="0,12,0,0"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#FF888888" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="1 计数 =" VerticalAlignment="Center" />
                                        <TextBox x:Name="ScaleInput" Width="56" Text="0.5" Margin="4,0"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock Text="mm" VerticalAlignment="Center" />
                                        <Button Content="应用比例" Margin="8,0,0,0" Padding="8,2"
                                                Click="OnApplyManualScale" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="模拟计数 =" VerticalAlignment="Center" />
                                        <TextBox x:Name="SimCountInput" Width="56" Text="200" Margin="4,0"
                                                 VerticalContentAlignment="Center" />
                                        <Button Content="注入" Margin="8,0,0,0" Padding="8,2"
                                                Click="OnInjectSyntheticCount" />
                                    </StackPanel>

                                    <TextBlock Text="擦除形状：" Margin="0,12,0,0" Foreground="#FF444444" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton x:Name="ShapeRect" Content="矩形（默认）" GroupName="EraserShape"
                                                     IsChecked="True" Checked="OnShapeChanged" />
                                        <RadioButton x:Name="ShapeCircle" Content="正圆（等面积）" GroupName="EraserShape"
                                                     Margin="12,0,0,0" Checked="OnShapeChanged" />
                                    </StackPanel>

                                    <CheckBox x:Name="AutoRatioCheck" Content="自动倍率（= ①手掌面积 a ÷ ②按压峰值 b，自动计算）"
                                              IsChecked="True" Margin="0,12,0,0"
                                              Checked="OnAutoRatioChanged" Unchecked="OnAutoRatioChanged" />

                                    <TextBlock Text="手动倍率（取消自动后生效）：" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="#FF444444" />
                                    <Slider x:Name="RatioSlider" Minimum="0.2" Maximum="5" Value="1"
                                            TickFrequency="0.1" IsEnabled="False" ValueChanged="OnRatioChanged" />
                                    <TextBlock x:Name="RatioLabel" Text="倍率(自动) = 数据不足" Foreground="#FF444444" />

                                    <CheckBox x:Name="FollowPressureCheck" Content="随压力变化（关闭则固定为手掌面积）"
                                              IsChecked="True" Margin="0,8,0,0"
                                              Checked="OnFollowPressureChanged" Unchecked="OnFollowPressureChanged" />

                                    <Button Content="清除预览" Margin="0,10,0,0" Padding="4,3" Click="OnClearEraserPreview" />

                                    <TextBlock x:Name="EraserInfoText" Margin="0,12,0,0" TextWrapping="Wrap"
                                               FontFamily="Consolas" Foreground="#FF0A5A9A"
                                               Text="在本页用真触摸屏按一下手掌，这里会实时显示接触面积与等大的擦除区。&#x0a;按住不放、改变按压轻重或手的角度，面积也会实时刷新（不抬手也变，取决于驱动是否上报）。" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

        </DockPanel>

        <!-- 引导层：覆盖全窗口，运行时才显示 -->
        <Canvas x:Name="GuideLayer" Visibility="Collapsed">
            <Path x:Name="GuideDim" Fill="#B0000000" />
            <Border x:Name="GuideHole" BorderBrush="#FF33CCFF" BorderThickness="3"
                    CornerRadius="6" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border x:Name="GuideCard" Width="400" Background="White" CornerRadius="10"
                    BorderBrush="#FF33CCFF" BorderThickness="2" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="GuideStepText" Foreground="#FF888888" FontSize="12" />
                    <TextBlock x:Name="GuideTitle" FontSize="18" FontWeight="Bold" Margin="0,2,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="GuideBody" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Foreground="#FF333333" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="GuideSkip" Content="跳过引导" Click="OnGuideSkip" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="GuideBack" Content="上一步" Click="OnGuideBack" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="GuideNext" Content="下一步" Click="OnGuideNext" Padding="18,4"
                                Background="#FF33CCFF" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
